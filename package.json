{
  "name": "ink-battle",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "lint": "eslint src scripts tests",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "simulate": "node scripts/simulate.mjs",
    "check": "npm run lint && npm test && npm run build",
    "release:check": "npm run check && npm run simulate -- --release && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0"
  }
}
