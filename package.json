{
  "name": "ink-battle",
  "version": "2.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "lint": "eslint src scripts tests",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "simulate": "node scripts/simulate.mjs",
    "check": "npm run lint && npm test && npm run build",
    "release:check": "npm run check && npm run simulate -- --release && npm run test:tabletop && npm run test:browser",
    "test:gemma": "node scripts/test-gemma.mjs",
    "test:tabletop": "node scripts/test-tabletop.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "iwer": "2.5.0"
  },
  "dependencies": {
    "@litert-lm/core": "0.12.1",
    "@noble/hashes": "2.4.0",
    "three": "0.186.0"
  }
}
